{
  "name": "@anipres/agent-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "anipres-agent": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "start": "node --import tsx/esm src/bin.ts"
  },
  "dependencies": {
    "@anipres/agent-core": "workspace:*",
    "anipres": "workspace:*",
    "citty": "^0.1.6",
    "happy-dom": "^20.9.0",
    "tldraw": "3.15.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.0"
  }
}
