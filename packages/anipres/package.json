{
  "name": "anipres",
  "version": "0.13.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./anipres.css": "./src/styles.ts",
    "./schema": "./src/schema.ts",
    "./models": "./src/models-and-tracks.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whitphx/anipres.git",
    "directory": "packages/anipres"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/anipres.js"
      },
      "./anipres.css": "./dist/anipres.css",
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./models": {
        "types": "./dist/models-and-tracks.d.ts",
        "default": "./dist/models-and-tracks.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "classnames": "^2.5.1",
    "re-resizable": "^6.11.2",
    "fractional-indexing-jittered": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "happy-dom": "^20.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "3.15.5"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "3.15.5"
  }
}
